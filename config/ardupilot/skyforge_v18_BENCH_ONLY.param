# SKYFORGE V18 FALCON - BENCH-ONLY PORT MAP for ArduPilot Plane (target SpeedyBeeF405WING)
#
# THIS IS NOT A FLIGHT TUNE, FAILSAFE PACKAGE, SERVO CALIBRATION OR MODE-SWITCH CONFIG.
# It only assigns ports so Stage-8 props-OFF bring-up can start. Load on a fresh parameter set,
# reboot after Q_ENABLE, then re-load so the Q_ parameters exist. Values marked "calibrate"
# must be replaced by measured values. Lines starting with # are ignored by Mission Planner/QGC.
# Source of pin numbers: ArduPilot hwdef/SpeedyBeeF405WING (ADC 10 = batt V, 11 = PDB current,
# 14 = RSSI pad, 15 = analog airspeed pad; PWM groups 1-2 | 3-4 | 5-7 | 8-10 | 11-12).
#
# --- QuadPlane frame ---
Q_ENABLE,1
Q_FRAME_CLASS,1
Q_FRAME_TYPE,1
# Initial PWM to the 4-in-1 (DShot later, only after PWM bring-up passes)
Q_M_PWM_TYPE,0
Q_M_PWM_MIN,1000
Q_M_PWM_MAX,2000
#
# --- Output functions (must match config/pinmap.csv; tools/check_repo.py enforces it) ---
SERVO1_FUNCTION,33
SERVO2_FUNCTION,34
SERVO3_FUNCTION,35
SERVO4_FUNCTION,36
SERVO5_FUNCTION,77
SERVO6_FUNCTION,78
SERVO7_FUNCTION,2
SERVO8_FUNCTION,2
SERVO9_FUNCTION,26
SERVO10_FUNCTION,0
SERVO11_FUNCTION,70
SERVO12_FUNCTION,0
SERVO11_MIN,1000
SERVO11_MAX,2000
SERVO11_TRIM,1000
#
# --- Receiver (ELRS/CRSF on UART1: Rx TX->R1, Rx RX->T1) ---
SERIAL1_PROTOCOL,23
RSSI_TYPE,3
# Reference channel order CH1 roll / CH2 pitch / CH3 throttle / CH4 yaw
RCMAP_ROLL,1
RCMAP_PITCH,2
RCMAP_THROTTLE,3
RCMAP_YAW,4
RC7_OPTION,208
#
# --- GNSS on UART3 (GNSS TX->R3, GNSS RX->T3) ---
SERIAL3_PROTOCOL,5
#
# --- Battery 1 = TOTAL (Mauch HS-200-LV current out -> RSSI pad = ADC 14; voltage from PDB ADC 10) ---
BATT_MONITOR,4
BATT_VOLT_PIN,10
# calibrate against a meter (hwdef default 11.05)
BATT_VOLT_MULT,11.05
BATT_CURR_PIN,14
BATT_CAPACITY,3300
# calibrate: enter the Amps-per-volt and offset from the Mauch test sheet, then check vs the bench meter
# BATT_AMP_PERVLT,<from Mauch sheet>
# BATT_AMP_OFFSET,<from Mauch sheet>
#
# --- Battery 2 = FC/PDB branch only (onboard shunt, ADC 11) ---
BATT2_MONITOR,4
BATT2_VOLT_PIN,10
BATT2_VOLT_MULT,11.05
BATT2_CURR_PIN,11
BATT2_AMP_PERVLT,50
#
# --- Airspeed (ASPD-4525 on I2C) - not used for control until calibrated ---
ARSPD_TYPE,1
ARSPD_USE,0
# Set ARSPD_BUS to the bus the sensor is detected on (check the boot log / I2C scan)
#
# --- Keep all pre-arm checks ---
ARMING_CHECK,1
